model historial_estados_postulacion {
  id              String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  postulacion_id  String                   @db.Uuid
  estado_anterior estado_postulacion_enum?
  estado_nuevo    estado_postulacion_enum
  observacion     String?
  created_at      DateTime                 @default(now()) @db.Timestamptz(6)

  postulaciones postulaciones @relation(fields: [postulacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_historial_postulacion")

  @@index([postulacion_id, created_at], map: "idx_historial_postulacion_fecha")
}


model gerencias {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre     String   @unique @db.VarChar(150)
  activo     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  departamentos departamentos[]
}

model departamentos {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  gerencia_id String   @db.Uuid
  nombre      String   @db.VarChar(150)
  activo      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  gerencias gerencias @relation(fields: [gerencia_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  usuarios_administrativos        usuarios_administrativos[]
  pasantes_activos                pasantes_activos[]
  perfiles_personal               perfiles_personal[]
  solicitudes_requerimiento_area  solicitudes_requerimiento_area[]
  solicitudes_pasante_supervisor  solicitudes_pasante_supervisor[]

  @@unique([gerencia_id, nombre], map: "uq_departamento_gerencia")
  @@index([gerencia_id], map: "idx_departamentos_gerencia_id")
  @@index([activo], map: "idx_departamentos_activo")
}

model notificaciones_administrativas {
  id                       String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  usuario_administrativo_id String  @db.Uuid
  solicitud_pasante_id     String?  @db.Uuid

  tipo                     String   @db.VarChar(60)
  titulo                   String   @db.VarChar(180)
  mensaje                  String   @db.Text

  leida                    Boolean  @default(false)
  fecha_leida              DateTime? @db.Timestamptz(6)

  created_at               DateTime @default(now()) @db.Timestamptz(6)

  usuario_administrativo usuarios_administrativos @relation(fields: [usuario_administrativo_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  solicitud_pasante      solicitudes_pasante_supervisor? @relation(fields: [solicitud_pasante_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([usuario_administrativo_id], map: "idx_notificaciones_usuario")
  @@index([solicitud_pasante_id], map: "idx_notificaciones_solicitud")
  @@index([usuario_administrativo_id, leida, created_at], map: "idx_notificaciones_usuario_leida")
}